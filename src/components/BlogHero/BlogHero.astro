---
type Props = {
  duration: number;
  pubDate: Date;
  title: string;
};

const { title, pubDate, duration = 1 } = Astro.props;

const date = new Date(pubDate).toLocaleDateString('en-GB');
---

<header class="bg-tertiary-light py-4xl" data-testid="blog-hero">
  <div class="max-w-8xl gap-md px-xs pt-md mx-auto flex flex-col text-center">
    <h1 class="font-heading">{title}</h1>
    <p class="font-title">{date}</p>
    <div class="flex justify-center gap-3">
      <p class="font-body">{duration} minute read</p>
      <span class="text-tertiary" aria-hidden="true">•</span>
      <a href="/blog/" class="font-body hover:text-tertiary">Back to blog</a>
    </div>
  </div>
</header>
