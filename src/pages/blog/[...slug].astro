---
import { Image } from 'astro:assets';
import { type CollectionEntry, getCollection, render } from 'astro:content';

import BlogHero from '@/components/BlogHero/BlogHero.astro';
import { SITE_AUTHOR, SITE_TITLE } from '@/consts/consts';
import Layout from '@/layouts/Layout.astro';

type Props = CollectionEntry<'blog'>;
type Heading = {
  depth: number;
  slug: string;
  text: string;
};

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post: Props) => ({
    params: { slug: post.id },
    props: post,
  }));
}

const post = Astro.props;
const { Content, headings } = await render(post);
const { title, pubDate, updatedDate, listingImage, duration, description } = post.data;
const schema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description,
  image: listingImage ? [new URL(listingImage.src, Astro.site ?? Astro.url).toString()] : undefined,
  datePublished: pubDate.toISOString(),
  dateModified: (updatedDate ?? pubDate).toISOString(),
  author: {
    '@type': 'Person',
    name: SITE_AUTHOR,
  },
  mainEntityOfPage: Astro.url.toString(),
};
---

<Layout
  id="post"
  title={`${title} | ${SITE_TITLE}`}
  description={description}
  image={listingImage}
  ogType="article"
  publishedTime={pubDate}
  updatedTime={updatedDate ?? pubDate}
  schema={schema}
>
  <BlogHero title={title} pubDate={pubDate} duration={Number(duration)} />
  <article class="grid grid-cols-4">
    <section class="col-span-4 xl:col-span-1">
      <nav class="mt-xs px-lg xl:mt-4xl sticky top-0 py-4" aria-label="Contents">
        <details class="border-tertiary px-lg py-md flex flex-col border">
          <summary class="relative flex cursor-pointer items-center justify-between"
            ><h2 class="font-body xl:font-sub-heading">Contents</h2></summary
          >
          <ol
            class="gap-xs px-lg pt-md flex max-h-96 list-decimal flex-col overflow-auto"
            data-lenis-prevent
          >
            {
              headings
                .filter((h: Heading) => h.depth === 2 || h.depth === 3)
                .map((h: Heading) => (
                  <li class={`depth-${h.depth}`}>
                    <a href={`#${h.slug}`} class="font-body [@media(hover:hover)]:hover:underline">
                      {h.text}
                    </a>
                  </li>
                ))
            }
          </ol>
        </details>
      </nav>
    </section>
    <section
      class="blog-post-content body-text gap-xl px-lg py-lg xl:py-4xl col-span-4 flex flex-col xl:col-span-2 xl:col-start-2"
    >
      <Content />
    </section>
    <section class="-mt-3xl p-xl hidden xl:block">
      {
        listingImage && (
          <Image
            src={listingImage}
            alt=""
            widths={[320, 480, 640]}
            sizes="(min-width: 1280px) 20rem, 0px"
            loading="lazy"
          />
        )
      }
    </section>
  </article>
</Layout>

<style is:inline>
  .blog-post-content > p:first-of-type {
    font: var(--font-title-2);
  }

  details summary::after {
    border: solid var(--color-black);
    border-width: 0 3px 3px 0;
    content: '';
    display: inline-block;
    height: 10px;
    padding: var(--spacing-1);
    position: absolute;
    right: 0;
    transition: 0.25s;
    transform: rotate(45deg);
    width: 10px;
  }

  details[open] summary::after {
    transform: rotate(-135deg);
  }
</style>
